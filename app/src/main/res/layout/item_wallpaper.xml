<?xml version="1.0" encoding="utf-8"?>
<!--
    Une vignette de la grille des fonds.

    Le rapport largeur/hauteur suit celui de l'écran du panneau : une vignette déformée
    tromperait sur le rendu, ce qui est précisément ce qu'on vient vérifier ici.

    Le glyphe se superpose à l'image pour les cases qui n'en ont pas — l'écran animé, le
    diaporama, le lien à coller.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:background="@drawable/card_background">

            <ImageView
                android:id="@+id/wallpaper_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/wallpaper_preview" />

            <TextView
                android:id="@+id/wallpaper_glyph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="30sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/wallpaper_check"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:gravity="center"
                android:text="@string/wallpaper_check_mark"
                android:textColor="@color/background"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/room_chip"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/wallpaper_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
