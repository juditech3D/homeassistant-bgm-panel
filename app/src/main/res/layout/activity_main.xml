<?xml version="1.0" encoding="utf-8"?>
<!--
    Racine en FrameLayout : l'écran de veille doit recouvrir la totalité de
    l'interface, bandeau compris, sinon il ne fait pas illusion.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dashboard_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
            Bandeau supérieur. L'heure y tient la place principale : sur un panneau
            fixé au mur, c'est ce qu'on regarde le plus souvent, et de loin. L'état de
            la connexion se réduit à une pastille colorée — afficher l'adresse du
            serveur en permanence n'apprend rien à l'usage et l'expose inutilement.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <!--
                Ni horloge ni date : l'écran rond du bouton rotatif les affiche déjà,
                à trente centimètres de là. Les répéter ici ne ferait que consommer la
                place des tuiles.
            -->
            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!--
                Commandes du panneau lui-même : volume de l'amplificateur, assistant
                vocal, mode privé. Elles ont quitté la grille : ce ne sont pas des
                entités de la maison, et elles occupaient trois tuiles parmi les lampes.
                Le volume se règle à la barre, directement, sans passer par une
                sélection.
            -->
            <LinearLayout
                android:id="@+id/panel_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/panel_volume_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="20sp" />

                <SeekBar
                    android:id="@+id/panel_volume_bar"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="6dp"
                    android:max="100" />

                <TextView
                    android:id="@+id/panel_assistant"
                    style="@style/HeaderIcon"
                    android:contentDescription="@string/assistant_enabled" />

                <TextView
                    android:id="@+id/panel_mic"
                    style="@style/HeaderIcon"
                    android:contentDescription="@string/feature_microphone" />
            </LinearLayout>

            <!-- Pastille d'état : verte connecté, rouge sinon. -->
            <TextView
                android:id="@+id/status_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="●"
                android:textColor="@color/status_error"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/status_connecting"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/cameras_button"
                style="@style/HeaderIcon"
                android:contentDescription="@string/cameras_title"
                android:visibility="gone" />

            <TextView
                android:id="@+id/entities_button"
                style="@style/HeaderIcon"
                android:contentDescription="@string/entities" />

            <TextView
                android:id="@+id/settings_button"
                style="@style/HeaderIcon"
                android:layout_marginStart="2dp"
                android:contentDescription="@string/settings" />

        </LinearLayout>

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:gravity="center"
            android:text="@string/no_entities"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <!--
            Les tuiles a gauche, la musique a droite. Sur une centrale de sonorisation,
            la lecture merite une colonne a demeure plutot qu'une tuile noyee parmi les
            lampes — et le format 1024x600 laisse la place aux deux.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tiles"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:clipToPadding="false"
                android:scrollbars="none" />

            <LinearLayout
                android:layout_width="268dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp">

                <com.judit.hapanel.WeatherCardView
                    android:id="@+id/weather_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:visibility="gone" />

                <com.judit.hapanel.MediaCardView
                    android:id="@+id/media_card"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!--
            Rappel du fonctionnement du bouton, en pied de page et discret : utile les
            premiers jours, inutile ensuite, et il n'a rien à faire en haut de l'écran.
        -->
        <TextView
            android:id="@+id/knob_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:text="@string/knob_hint"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

    </LinearLayout>

    <com.judit.hapanel.ScreensaverView
        android:id="@+id/screensaver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!--
        La caméra passe par-dessus tout, écran de veille compris : quand on sonne, c'est
        ce qu'on veut voir immédiatement.
    -->
    <com.judit.hapanel.CameraView
        android:id="@+id/camera"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
