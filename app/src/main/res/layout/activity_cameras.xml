<?xml version="1.0" encoding="utf-8"?>
<!--
    Vue caméras : une grille de vignettes, l'appui ouvre le plein écran.

    Les vignettes se rafraîchissent l'une après l'autre plutôt que toutes ensemble :
    cinq flux simultanés mettraient à genoux un panneau de 2 Go, et de toute façon on
    ne regarde qu'une caméra à la fois.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dashboard_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cameras_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cameras_choose"
                style="@style/HeaderIcon"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/cameras_choose" />

            <TextView
                android:id="@+id/cameras_close"
                style="@style/HeaderIcon"
                android:contentDescription="@string/back" />
        </LinearLayout>

        <TextView
            android:id="@+id/cameras_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:gravity="center"
            android:text="@string/cameras_none"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cameras_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

    </LinearLayout>

    <com.judit.hapanel.CameraView
        android:id="@+id/cameras_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
