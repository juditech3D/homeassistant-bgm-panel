<?xml version="1.0" encoding="utf-8"?>
<!--
    Fond du tableau de bord : une photographie de dégradé, voilée de noir.

    L'image est très saturée ; telle quelle, elle rendrait le texte illisible et les
    cartes invisibles. Le voile la ramène à ce qu'on attend d'un fond — une présence
    colorée en arrière-plan, pas un sujet. Les cartes étant légèrement translucides,
    les teintes transparaissent au travers.

    En drawable-nodpi : c'est une toile de fond plein écran, la mise à l'échelle par
    densité n'aurait aucun sens et gonflerait la mémoire.

    Photo de Codioful (Gradienta), Pexels — licence libre, voir NOTICE.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <bitmap
            android:src="@drawable/dashboard_photo"
            android:gravity="fill" />
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3060810" />
        </shape>
    </item>

</layer-list>
