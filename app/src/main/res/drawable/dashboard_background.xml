<?xml version="1.0" encoding="utf-8"?>
<!--
    Fond du tableau de bord : un bleu très sombre, réchauffé par deux lueurs diffuses
    dans les angles. Elles donnent de la profondeur sans rien coûter — ce sont des
    dégradés dessinés, pas une image — et font ressortir les cartes, qui sont
    légèrement translucides.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background" />
        </shape>
    </item>

    <!-- Lueur froide, en haut à droite. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.92"
                android:centerY="0.04"
                android:gradientRadius="75%p"
                android:startColor="#3C1E6FD9"
                android:endColor="#001E6FD9" />
        </shape>
    </item>

    <!-- Lueur chaude, en bas à droite : elle équilibre la première. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.02"
                android:centerY="0.92"
                android:gradientRadius="55%p"
                android:startColor="#2EE0603A"
                android:endColor="#00E0603A" />
        </shape>
    </item>

</layer-list>
