<?xml version="1.0" encoding="utf-8"?>
<!--
    Pastille de piece dans la carte musique. Celle qu'on commande est mise en avant par
    l'accentuation ; les autres restent en retrait mais restent lisibles.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/tile_selected" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/tile_off" />
            <stroke android:width="1dp" android:color="@color/tile_border" />
        </shape>
    </item>
</selector>
