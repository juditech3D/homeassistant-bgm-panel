<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Tuile sélectionnée : c'est elle que le bouton rotatif pilote. -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/tile_selected" />
            <stroke android:width="3dp" android:color="@color/accent" />
        </shape>
    </item>

    <!-- Entité allumée. -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/tile_on" />
            <stroke android:width="1dp" android:color="@color/tile_border" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/tile_off" />
            <stroke android:width="1dp" android:color="@color/tile_border" />
        </shape>
    </item>

</selector>
